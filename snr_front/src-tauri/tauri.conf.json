{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "https://localhost:52840/",
    "distDir": "../dist"
  },
  "package": {
    "productName": "snr_front",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "open": true },
      "http": {
        "all": true,
        "scope": ["http://10.46.79.236:8080/*"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.mystical-mage.snr",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [{
      "title": "SNRC",
      "width": 1240,
      "height": 712,
      "resizable": true,
      "fullscreen": false
    }]
  }
}